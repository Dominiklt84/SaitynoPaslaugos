<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-dealership-table" author="d.alencinovic">
        <createTable tableName="car_dealership">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="established_year" type="int">
                <constraints nullable="false"/>
            </column>
            <column name="total_income" type="decimal(15,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="load-dealership-data" author="d.alencinovic">
        <loadData separator=";" tableName="CAR_DEALERSHIP" file="car_dealership.csv"
                  relativeToChangelogFile="true"/>
    </changeSet>

</databaseChangeLog>