<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-restaurant-table" author="d.alencinovic">
        <createTable tableName="restaurant">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="varchar(255)">
                <constraints nullable="false"/>a
            </column>
            <column name="open" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="float">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="load-restaurant-data" author="d.alencinovic">
        <loadData separator=";" tableName="RESTAURANT" file="restaurant.csv"
                  relativeToChangelogFile="true"/>
    </changeSet>

</databaseChangeLog>