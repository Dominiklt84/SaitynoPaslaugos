<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-item-table" author="d.alencinovic">
        <createTable tableName="menu_item">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="float">
                <constraints nullable="false"/>
            </column>
            <column name="available" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="restaurant_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="menu_item"
                baseColumnNames="restaurant_id"
                referencedTableName="restaurant"
                referencedColumnNames="id"
                constraintName="fk_menuitem_restaurant"/>
    </changeSet>
    <changeSet id="load-item-data" author="d.alencinovic">
        <loadData separator=";" tableName="MENU_ITEM" file="menu_item.csv"
                  relativeToChangelogFile="true"/>
    </changeSet>

</databaseChangeLog>